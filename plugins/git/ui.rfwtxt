// The Git page: repositories in the scope, one repository's code, commits
// and pushes, a file, or a commit with its changes, as `data.mode` says.
// Event names are handled in src/lib.rs.
//
// ListView builds its children lazily, during layout: they use library
// widgets directly, not ones declared here, which would subscribe to data
// mid-build.
import core.widgets;
import core.material;
import ournet;

widget Git = switch data.mode {
  "new": GitNew(),
  "repo": GitRepo(),
  "file": GitFile(),
  "commit": GitCommit(),
  default: GitList(),
};

widget Mono = Text(
  text: args.text,
  softWrap: false,
  style: { fontFamily: "Consolas", fontFamilyFallback: ["monospace", "Menlo", "Courier New"], fontSize: 13.0 },
);

widget GitList = Column(
  crossAxisAlignment: "stretch",
  children: [
    Padding(
      padding: [16.0, 12.0, 16.0, 0.0],
      child: Row(
        children: [
          Expanded(child: Text(text: "Repositories", style: { fontSize: 22.0, fontWeight: "w600" })),
          ElevatedButton(onPressed: event "new" { }, child: Text(text: "New repository")),
        ],
      ),
    ),
    Padding(padding: [16.0, 2.0, 16.0, 8.0], child: Text(text: data.where)),
    Expanded(
      child: ListView(
        children: [
          ...for repo in data.repos:
            ListTile(
              title: Text(text: repo.name, style: { fontWeight: "w600" }),
              subtitle: Column(
                crossAxisAlignment: "start",
                children: [
                  Text(text: repo.description),
                  Row(
                    children: [
                      PersonName(person: repo.owner),
                      Text(text: " · updated "),
                      TimeAgo(at: repo.at),
                    ],
                  ),
                ],
              ),
              onTap: event "open" { key: repo.key },
            ),
          switch data.empty {
            true: Padding(padding: [16.0, 16.0, 16.0, 16.0], child: Text(text: data.emptyText)),
            default: SizedBoxShrink(),
          },
        ],
      ),
    ),
  ],
);

widget GitNew = SingleChildScrollView(
  padding: [16.0, 12.0, 16.0, 16.0],
  child: Column(
    crossAxisAlignment: "stretch",
    children: [
      Row(
        children: [
          TextButton(onPressed: event "back" { }, child: Text(text: "‹ Repositories")),
        ],
      ),
      Text(text: "New repository", style: { fontSize: 22.0, fontWeight: "w600" }),
      Padding(padding: [0.0, 4.0, 0.0, 12.0], child: Text(text: data.where)),
      TextInput(label: "Name", hint: "my-project", value: data.draftName, onChanged: event "draftName" { }),
      SizedBox(height: 12.0),
      TextInput(label: "Description (optional)", value: data.draftDescription, onChanged: event "draftDescription" { }),
      switch data.error {
        "": SizedBoxShrink(),
        default: Padding(padding: [0.0, 8.0, 0.0, 0.0], child: Text(text: data.error, style: { color: 0xFFC62828 })),
      },
      SizedBox(height: 16.0),
      Row(
        children: [
          ElevatedButton(onPressed: event "create" { }, child: Text(text: "Create")),
        ],
      ),
    ],
  ),
);

widget RepoHeader = Column(
  crossAxisAlignment: "stretch",
  children: [
    Padding(
      padding: [8.0, 8.0, 16.0, 0.0],
      child: Row(
        children: [
          TextButton(onPressed: event "back" { }, child: Text(text: "‹")),
          Expanded(child: Text(text: data.repo.name, style: { fontSize: 22.0, fontWeight: "w600" })),
          PersonName(person: data.repo.owner),
        ],
      ),
    ),
    switch data.repo.description {
      "": SizedBoxShrink(),
      default: Padding(padding: [16.0, 0.0, 16.0, 4.0], child: Text(text: data.repo.description)),
    },
    Padding(
      padding: [16.0, 4.0, 16.0, 0.0],
      child: Row(children: [OutlinedButton(onPressed: event "clone" { }, child: Text(text: "Code ▾")), SizedBox(width: 8.0), OutlinedButton(onPressed: event "tab" {tab: "fork"}, child: Text(text: "Fork"))]),
    ),
    Padding(padding: [16.0, 4.0, 16.0, 4.0], child: CopyableText(label: "Repository URL", text: data.repo.url)),
    switch data.cloneOpen {
      true: Padding(padding: [16.0, 4.0, 16.0, 4.0], child: CopyableText(label: "Clone command", text: data.repo.clone)),
      default: SizedBoxShrink(),
    },
    switch data.indexProgress {
      "": SizedBoxShrink(),
      default: Padding(padding: [16.0, 4.0, 16.0, 4.0], child: Text(text: data.indexProgress)),
    },
    Padding(
      padding: [8.0, 4.0, 8.0, 0.0],
      child: SingleChildScrollView(scrollDirection: "horizontal", child: Row(
        children: [
          TextButton(onPressed: event "tab" { tab: "code" }, child: Text(text: "Code")),
          TextButton(onPressed: event "tab" { tab: "commits" }, child: Text(text: "Commits")),
          TextButton(onPressed: event "tab" { tab: "pushes" }, child: Text(text: "Activity")),
          TextButton(onPressed: event "tab" { tab: "pulls" }, child: Text(text: "Pull requests")),
          TextButton(onPressed: event "tab" { tab: "network" }, child: Text(text: "Network")),
          TextButton(onPressed: event "tab" { tab: "compare" }, child: Text(text: "Compare")),
          TextButton(onPressed: event "tab" { tab: "settings" }, child: Text(text: "Settings")),
          SizedBox(width: 12.0),
          Text(text: data.branch, style: { fontWeight: "w600" }),
        ],
      )),
    ),
    switch data.copyProgress {
      "": SizedBoxShrink(),
      default: Padding(padding: [16.0, 4.0, 16.0, 4.0], child: Wrap(children: [Text(text: data.copyProgress),
        switch data.copyPaused {
          true: TextButton(onPressed: event "copyResume" {}, child: Text(text: "Resume")),
          default: TextButton(onPressed: event "copyPause" {}, child: Text(text: "Pause")),
        },
      ])),
    },
    switch data.error {
      "": SizedBoxShrink(),
      default: Padding(padding: [16.0, 4.0, 16.0, 4.0], child: Text(text: data.error)),
    },
    switch data.repo.parent {
      "": SizedBoxShrink(),
      default: TextButton(onPressed: event "upstream" {}, child: Text(text: "Fork · open upstream repository")),
    },
    Divider(),
  ],
);

widget GitRepo = Column(
  crossAxisAlignment: "stretch",
  children: [
    RepoHeader(),
    Expanded(
      child: switch data.tab {
        "pulls": GitPulls(),
        "network": GitNetwork(),
        "compare": GitCompare(),
        "fork": GitFork(),
        "settings": GitSettings(),
        default: switch data.empty {
        true: SingleChildScrollView(
          padding: [16.0, 8.0, 16.0, 16.0],
          child: Column(
            crossAxisAlignment: "stretch",
            children: [
              Text(text: "Nothing pushed yet", style: { fontSize: 18.0, fontWeight: "w600" }),
              Padding(
                padding: [0.0, 8.0, 0.0, 8.0],
                child: Text(text: "With git-remote-ournet on your PATH and OurNet running, push an existing repository:"),
              ),
              Mono(text: data.pushHelp),
            ],
          ),
        ),
        default: switch data.tab {
          "commits": GitCommits(),
          "pushes": GitPushes(),
          default: GitCode(),
        },
      },
      },
    ),
  ],
);

widget Crumbs = Padding(
  padding: [8.0, 0.0, 8.0, 0.0],
  child: Wrap(
    crossAxisAlignment: "center",
    children: [
      ...for crumb in data.crumbs:
        TextButton(onPressed: event "crumb" { depth: crumb.depth }, child: Text(text: crumb.name)),
    ],
  ),
);

widget GitCode = ListView(
  children: [
    Padding(
      padding: [16.0, 4.0, 16.0, 4.0],
      child: Row(children: [OutlinedButton(onPressed: event "branches" { }, child: Text(text: data.branch))]),
    ),
    switch data.branchesOpen {
      true: Column(
        crossAxisAlignment: "stretch",
        children: [
          Padding(padding: [16.0, 4.0, 16.0, 8.0], child: TextInput(label: "Find a branch or tag", value: data.branchFilter, onChanged: event "branchFilter" { })),
          SizedBox(
            height: 220.0,
            child: ListView(
              children: [
                ...for b in data.branches:
                  ListTile(dense: true, title: Text(text: b.name), onTap: event "branch" { ref: b.ref }),
              ],
            ),
          ),
          Row(children: [
            switch data.previousBranches {
              true: TextButton(onPressed: event "previousBranches" { }, child: Text(text: "Previous branches/tags")),
              default: SizedBoxShrink(),
            },
            switch data.moreBranches {
              true: TextButton(onPressed: event "nextBranches" { }, child: Text(text: "More branches/tags")),
              default: SizedBoxShrink(),
            },
          ]),
        ],
      ),
      default: SizedBoxShrink(),
    },
    Padding(
      padding: [8.0, 0.0, 8.0, 0.0],
      child: Wrap(
        crossAxisAlignment: "center",
        children: [
          ...for crumb in data.crumbs:
            TextButton(onPressed: event "crumb" { depth: crumb.depth }, child: Text(text: crumb.name)),
        ],
      ),
    ),
    switch data.hasLast {
      false: SizedBoxShrink(),
      default: ListTile(
        dense: true,
        title: Text(text: data.last.title),
        subtitle: Row(
          children: [
            Text(text: data.last.author),
            Text(text: " · "),
            TimeAgo(at: data.last.at),
            Text(text: " · "),
            Text(text: data.last.short),
          ],
        ),
        onTap: event "commit" { sha: data.last.sha },
      ),
    },
    switch data.missing {
      true: Padding(padding: [16.0, 8.0, 16.0, 8.0], child: Text(text: "These files have not arrived here yet.")),
      default: SizedBoxShrink(),
    },
    switch data.plugin {
      "": SizedBoxShrink(),
      default: ListTile(
        dense: true,
        leading: Text(text: "🧩"),
        title: Text(text: data.plugin),
        subtitle: Text(text: "Install it from this branch or tag; the app asks you first."),
        trailing: ElevatedButton(onPressed: event "install" { }, child: Text(text: "Install as plugin")),
      ),
    },
    ...for entry in data.entries:
      ListTile(
        dense: true,
        leading: Text(text: entry.icon),
        title: Text(text: entry.name),
        onTap: event "entry" { name: entry.name, dir: entry.dir },
      ),
    switch data.readme {
      "": SizedBoxShrink(),
      default: Padding(
        padding: [16.0, 12.0, 16.0, 24.0],
        child: Markup(text: data.readme, repository: data.repo.url,
          commit: data.markdownCommit, directory: data.markdownDirectory,
          onLink: event "markdownLink" { commit: data.markdownCommit }),
      ),
    },
  ],
);

widget GitCommits = ListView(
  children: [
    ...for c in data.commits:
      ListTile(
        title: Text(text: c.title),
        subtitle: Row(
          children: [
            Text(text: c.author),
            Text(text: " · "),
            TimeAgo(at: c.at),
            Text(text: " · "),
            Text(text: c.short),
          ],
        ),
        onTap: event "commit" { sha: c.sha },
      ),
    switch data.more {
      true: Padding(
        padding: [16.0, 8.0, 16.0, 16.0],
        child: Row(children: [OutlinedButton(onPressed: event "more" { }, child: Text(text: "Older commits"))]),
      ),
      default: SizedBoxShrink(),
    },
  ],
);

widget GitPushes = ListView(
  children: [
    switch data.repo.notice {
      "": SizedBoxShrink(),
      default: Padding(padding: [16.0, 8.0, 16.0, 8.0], child: Text(text: data.repo.notice)),
    },
    ...for p in data.pushes:
      ListTile(
        leading: Avatar(person: p.author),
        title: Text(text: p.summary),
        subtitle: Column(
          crossAxisAlignment: "start",
          children: [
            Row(
              children: [
                PersonName(person: p.author),
                Text(text: " · "),
                TimeAgo(at: p.at),
              ],
            ),
            Text(text: p.detail),
          ],
        ),
      ),
    switch data.morePushes {
      true: Padding(padding: [16.0, 8.0, 16.0, 16.0], child: Row(children: [OutlinedButton(onPressed: event "morePushes" { }, child: Text(text: "Older activity"))])),
      default: SizedBoxShrink(),
    },
  ],
);

widget GitSettings = SingleChildScrollView(
  padding: [16.0, 8.0, 16.0, 24.0],
  child: Column(
    crossAxisAlignment: "stretch",
    children: [
      Text(text: "Repository settings", style: { fontSize: 20.0, fontWeight: "w600" }),
      SizedBox(height: 12.0),
      Text(text: data.repo.notice),
      Text(text: "Repair local browsing", style: { fontWeight: "w600" }),
      Text(text: "Re-read this repository's packs to rebuild its local index. Commits and branches are kept."),
      Row(children: [OutlinedButton(onPressed: event "repair" { }, child: Text(text: "Rebuild local index"))]),
      switch data.error {
        "": SizedBoxShrink(),
        default: Padding(padding: [0.0, 8.0, 0.0, 8.0], child: Text(text: data.error)),
      },
      SizedBox(height: 24.0),
      switch data.repo.mine {
        true: Column(
          crossAxisAlignment: "stretch",
          children: [
            Text(text: "Delete repository", style: { fontSize: 18.0, fontWeight: "w600", color: 0xFFC62828 }),
            Text(text: "Removes this repository and its old pushes from Git on devices running this version. Existing local clones are kept. You can create a fresh repository with the same name. Older plugin versions may still show the old data."),
            SizedBox(height: 12.0),
            TextInput(label: "Type the repository name to confirm", value: data.deleteName, onChanged: event "deleteName" { }),
            Row(children: [OutlinedButton(onPressed: event "delete" { }, child: Text(text: "Delete repository", style: { color: 0xFFC62828 }))]),
          ],
        ),
        default: Text(text: "Only people who can push to this repository can delete it."),
      },
    ],
  ),
);

widget GitFile = Column(
  crossAxisAlignment: "stretch",
  children: [
    RepoHeader(),
    Crumbs(),
    Padding(
      padding: [16.0, 0.0, 16.0, 4.0],
      child: Row(
        children: [
          Expanded(child: Text(text: data.file.name, style: { fontWeight: "w600" })),
          Text(text: data.file.note),
        ],
      ),
    ),
    Expanded(child: switch data.file.markdown {
      true: SingleChildScrollView(padding: [16.0, 4.0, 16.0, 24.0],
        child: Markup(text: data.file.text, repository: data.repo.url,
          commit: data.markdownCommit, directory: data.markdownDirectory,
          onLink: event "markdownLink" {commit: data.markdownCommit})),
      default: CodeBrowser(repository: data.repo.url, commit: data.markdownCommit,
        path: data.filePath, line: data.jumpLine, text: data.file.text, entries: data.siblings,
        onOpen: event "entry" {}),
    }),
  ],
);

widget GitCommit = Column(
  crossAxisAlignment: "stretch",
  children: [
    RepoHeader(),
    Expanded(
      child: ListView(
        children: [
          Padding(
            padding: [16.0, 4.0, 16.0, 0.0],
            child: Text(text: data.commit.title, style: { fontSize: 18.0, fontWeight: "w600" }),
          ),
          switch data.commit.body {
            "": SizedBoxShrink(),
            default: Padding(padding: [16.0, 4.0, 16.0, 0.0], child: Text(text: data.commit.body)),
          },
          Padding(
            padding: [16.0, 4.0, 16.0, 8.0],
            child: Row(
              children: [
                Text(text: data.commit.author),
                Text(text: " · "),
                TimeAgo(at: data.commit.at),
                Text(text: " · "),
                Text(text: data.commit.short),
              ],
            ),
          ),
          ...for line in data.diff:
            Container(
              color: line.bg,
              padding: [16.0, 0.0, 16.0, 0.0],
              child: Row(
                crossAxisAlignment: "start",
                children: [
                  SizedBox(width: 40.0, child: Text(text: line.oldLine, style: { fontFamily: "Consolas", fontSize: 12.0 })),
                  SizedBox(width: 40.0, child: Text(text: line.newLine, style: { fontFamily: "Consolas", fontSize: 12.0 })),
                  Expanded(child: Text(text: line.text, style: { fontFamily: "Consolas", fontFamilyFallback: ["monospace", "Menlo", "Courier New"], fontSize: 12.0 })),
                ],
              ),
            ),
          switch data.moreDiff {
            true: Padding(padding: [16.0, 8.0, 16.0, 16.0], child: Row(children: [OutlinedButton(onPressed: event "moreDiff" { }, child: Text(text: "Show more changes"))])),
            default: SizedBoxShrink(),
          },
        ],
      ),
    ),
  ],
);


widget GitCompare = ListView(children: [
  Padding(padding: [16.0, 8.0, 16.0, 16.0], child: Column(crossAxisAlignment: "stretch", children: [
    Text(text: "Compare branches or commits", style: {fontSize: 20.0, fontWeight: "w600"}),
    Text(text: "Compare exact snapshots in this repository or one of its forks."),
    TextInput(label: "Base ref or commit", value: data.compareBase, onChanged: event "compareBase" {}),
    TextInput(label: "Head repository URL or key", value: data.compareSource, onChanged: event "compareSource" {}),
    TextInput(label: "Head ref or commit", value: data.compareHead, onChanged: event "compareHead" {}),
    Row(children: [ElevatedButton(onPressed: event "compare" {}, child: Text(text: "Compare changes"))]),
    Divider(), GitLocationInput(onOpen: event "location" {}),
  ])),
]);

widget GitFork = SingleChildScrollView(padding: [16.0, 8.0, 16.0, 16.0],
  child: Column(crossAxisAlignment: "stretch", children: [
    Text(text: "Fork this repository", style: {fontSize: 20.0, fontWeight: "w600"}),
    Text(text: "Creates an independent copy of the history known to this device within the same sharing audience. Public forks go in your own public space. Group forks stay in the group. Personal forks stay personal."),
    TextInput(label: "Fork name", value: data.forkName, maxLength: 100, onChanged: event "forkName" {}),
    Row(children: [ElevatedButton(onPressed: event "fork" {}, child: Text(text: "Create fork"))]),
  ]),
);

widget GitPulls = ListView(children: [
  Padding(padding: [16.0, 8.0, 16.0, 16.0], child: Column(crossAxisAlignment: "stretch", children: [
    Text(text: "Pull requests", style: {fontSize: 20.0, fontWeight: "w600"}),
    ...for p in data.pulls: ListTile(title: Text(text: p.title), subtitle: Row(children: [
      Text(text: p.status), Text(text: " · "), PersonName(person: p.author),
    ]), onTap: event "pullOpen" {id: p.id}),
    Wrap(children: [
      TextButton(onPressed: event "pullFirst" {}, child: Text(text: "Newest requests")),
      switch data.morePulls {true: TextButton(onPressed: event "pullNext" {}, child: Text(text: "Older requests")), default: SizedBoxShrink()},
    ]),
    switch data.pullSelected {
      true: Column(crossAxisAlignment: "stretch", children: [
        Divider(), Text(text: data.pull.title, style: {fontSize: 22.0, fontWeight: "w600"}),
        Text(text: data.pull.status), PersonName(person: data.pull.author),
        Text(text: data.pull.source), Text(text: data.pull.headRef), Text(text: "proposes changes into"), Text(text: data.pull.baseRef),
        Markup(text: data.pull.body),
        CopyableText(label: "Proposal base commit", text: data.pull.base),
        CopyableText(label: "Current target commit", text: data.pull.currentBase),
        CopyableText(label: "Reviewed head commit", text: data.pull.head),
        Wrap(children: [
          OutlinedButton(onPressed: event "pullDiff" {}, child: Text(text: "Files changed")),
          OutlinedButton(onPressed: event "pullAction" {head: data.pull.head, action: "approve"}, child: Text(text: "Approve reviewed commit")),
          OutlinedButton(onPressed: event "pullAction" {head: data.pull.head, action: "request-changes"}, child: Text(text: "Request changes")),
        ]),
        switch data.pullCanManage {true: Wrap(children: [
          TextButton(onPressed: event "pullAction" {head: data.pull.head, action: "update"}, child: Text(text: "Update proposed head")),
          TextButton(onPressed: event "pullAction" {head: data.pull.head, action: "close"}, child: Text(text: "Close request")),
          TextButton(onPressed: event "pullAction" {head: data.pull.head, action: "reopen"}, child: Text(text: "Reopen request")),
        ]), default: SizedBoxShrink()},
        switch data.pullCanMerge {true: Wrap(children: [ElevatedButton(onPressed: event "pullMerge" {head: data.pull.head, base: data.pull.currentBase}, child: Text(text: "Merge fast-forward"))]), default: SizedBoxShrink()},
        Text(text: "A merge verifies ancestry and refuses a changed target. Diverged branches need a local Git merge. Reviews identify a specific proposed commit."),
        Divider(), Text(text: "Discussion and reviews", style: {fontWeight: "w600"}),
        ...for c in data.comments: Padding(padding: [0.0, 8.0, 0.0, 8.0], child: Column(crossAxisAlignment: "stretch", children: [
          Row(children: [PersonName(person: c.author), Text(text: " · "), Text(text: c.action), Text(text: " · "), TimeAgo(at: c.at)]),
          Markup(text: c.body),
          switch c.action {
            "approve": CopyableText(label: "Reviewed commit", text: c.head),
            "request-changes": CopyableText(label: "Reviewed commit", text: c.head),
            default: SizedBoxShrink(),
          },
        ])),
        Wrap(children: [TextButton(onPressed: event "commentFirst" {}, child: Text(text: "Newest comments")),
          switch data.moreComments {true: TextButton(onPressed: event "commentNext" {}, child: Text(text: "Older comments")), default: SizedBoxShrink()},
        ]),
        TextInput(label: "Comment or review", value: data.commentDraft, lines: 4, maxLength: 12000, onChanged: event "commentDraft" {}),
        Wrap(children: [ElevatedButton(onPressed: event "pullAction" {head: data.pull.head, action: "comment"}, child: Text(text: "Comment"))]),
      ]), default: SizedBoxShrink(),
    },
    Divider(), Text(text: "Propose changes from this branch", style: {fontSize: 18.0, fontWeight: "w600"}),
    TextInput(label: "Target repository URL or key", value: data.pullTarget, onChanged: event "pullTarget" {}),
    TextInput(label: "Target branch ref", value: data.pullBaseRef, onChanged: event "pullBaseRef" {}),
    TextInput(label: "Pull request title", value: data.pullTitle, maxLength: 200, onChanged: event "pullTitle" {}),
    TextInput(label: "Pull request description", value: data.pullBody, lines: 4, maxLength: 12000, onChanged: event "pullBody" {}),
    Wrap(children: [ElevatedButton(onPressed: event "newPull" {}, child: Text(text: "Create pull request"))]),
  ])),
]);

widget GitNetwork = ListView(children: [
  Padding(padding: [16.0, 8.0, 16.0, 8.0], child: Column(crossAxisAlignment: "stretch", children: [
    Text(text: "Repository network", style: {fontSize: 20.0, fontWeight: "w600"}),
    Text(text: "Branches and forks visible to this device. Drag to pan, pinch to zoom, and select a commit to inspect it. Other private forks remain private."),
    switch data.networkLoading {true: Text(text: "Loading commit connections…"), default: SizedBoxShrink()},
    SizedBox(height: 430.0, child: CommitNetwork(nodes: data.networkNodes, lanes: data.networkLanes, onCommit: event "networkCommit" {})),
    Wrap(children: [
      TextButton(onPressed: event "networkRefresh" {}, child: Text(text: "Newest commits")),
      switch data.networkMore {true: TextButton(onPressed: event "networkMore" {}, child: Text(text: "Older commits")), default: SizedBoxShrink()},
      switch data.networkPreviousBranches {true: TextButton(onPressed: event "networkBranchesPrevious" {}, child: Text(text: "Previous branches")), default: SizedBoxShrink()},
      switch data.networkMoreBranches {true: TextButton(onPressed: event "networkBranchesNext" {}, child: Text(text: "More branches")), default: SizedBoxShrink()},
    ]),
    Text(text: "Forks and upstream", style: {fontSize: 18.0, fontWeight: "w600"}),
    ...for r in data.networkForks: ListTile(title: Text(text: r.name), subtitle: PersonName(person: r.owner), onTap: event "open" {key: r.key}),
  ])),
]);
