<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_board_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:text="Notes" android:contentDescription="Open OurNet notes" android:textColor="#143D32" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_board_new_text" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="＋" android:contentDescription="New note" android:textColor="#143D32" android:textSize="24sp" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_board_new_voice" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:gravity="center" android:text="🎤" android:contentDescription="New voice note" android:textColor="#143D32" android:textSize="21sp" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_board_new_list" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:gravity="center" android:text="☑" android:contentDescription="New list" android:textColor="#143D32" android:textSize="22sp" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_board_settings" android:layout_width="40dp" android:layout_height="44dp" android:gravity="center" android:text="⚙" android:contentDescription="Widget settings" android:textColor="#355D4F" android:textSize="20sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ListView android:id="@+id/widget_board_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:scrollbars="none" />
        <TextView android:id="@+id/widget_board_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:text="Open OurNet to show your notes" android:textColor="#355D4F" android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
