<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:text="OurNet note" android:textColor="#143D32" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:contentDescription="Widget settings" android:textColor="#143D32" android:textSize="24sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="5" android:ellipsize="end" android:textColor="#143D32" android:textSize="16sp" />
    <LinearLayout android:id="@+id/widget_checks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:textColor="#355D4F" android:textSize="12sp" />
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="end|center_vertical" android:text="Open in OurNet ↗" android:textColor="#143D32" android:textSize="14sp" />
</LinearLayout>
