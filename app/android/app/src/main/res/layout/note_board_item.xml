<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/board_item_root"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/board_item_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/board_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <TextView android:id="@+id/board_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#1F2A26" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/board_item_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="6" android:ellipsize="end" android:textColor="#1F2A26" android:textSize="14sp" />
        <TextView android:id="@+id/board_item_checks" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="9" android:ellipsize="end" android:lineSpacingExtra="2dp" android:textColor="#1F2A26" android:textSize="14sp" />
        <TextView android:id="@+id/board_item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textColor="#4A5A54" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
