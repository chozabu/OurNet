<?xml version="1.0" encoding="utf-8"?>
<!-- Firebase Cloud Messaging, for push wake-up (PushWake.kt). Copy these from
     the Firebase project's google-services.json (see OurNetPushServer's
     README). They identify the app and are not secret. Left empty, Firebase
     does not start and push wake-up is unavailable. -->
<resources>
    <!-- client[0].client_info.mobilesdk_app_id -->
    <string name="google_app_id" translatable="false"></string>
    <!-- client[0].api_key[0].current_key -->
    <string name="google_api_key" translatable="false"></string>
    <!-- project_info.project_number -->
    <string name="gcm_defaultSenderId" translatable="false"></string>
    <!-- project_info.project_id -->
    <string name="project_id" translatable="false"></string>
</resources>
