<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The F-Droid build: the full build without Google's libraries. It has
         the friend network's VpnService (as src/full) and no Firebase push
         wake-up, so main's PushWake service is removed. -->
    <application>
        <service
            android:name=".FriendVpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service android:name=".PushWake" tools:node="remove" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" tools:node="remove" />
    </application>
</manifest>
