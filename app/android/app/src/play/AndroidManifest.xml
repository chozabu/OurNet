<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Google Play build: push wake-up, but no VpnService (see src/full). -->
    <application>
        <!-- Push wake-up: friends wake OurNet through FCM (PushWake, in
             src/gms). Firebase starts only when res/values/firebase.xml is
             filled in, and makes no token until push wake-up is turned on. -->
        <service android:name=".PushWake" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    </application>
</manifest>
